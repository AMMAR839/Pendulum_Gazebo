<?xml version="1.0"?>
<robot name="linear_inverted_pendulum" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.141592653589793"/>

  <!-- Manual LIP01 values used here:
       rail travel 78 cm, base 1000 mm x 350 mm, rod D8 x 400 mm, rod mass 200 g. -->
  <xacro:property name="travel" value="0.78"/>
  <xacro:property name="base_length" value="1.00"/>
  <xacro:property name="base_width" value="0.35"/>
  <xacro:property name="base_height" value="0.04"/>
  <xacro:property name="rail_length" value="0.90"/>
  <xacro:property name="rail_radius" value="0.005"/>
  <xacro:property name="rail_y" value="0.075"/>
  <xacro:property name="rail_z" value="0.10"/>
  <xacro:property name="pivot_z" value="0.50"/>
  <xacro:property name="cart_mass" value="1.20"/>
  <xacro:property name="cart_x" value="0.14"/>
  <xacro:property name="cart_y" value="0.18"/>
  <xacro:property name="cart_z" value="0.08"/>
  <xacro:property name="pendulum_length" value="0.40"/>
  <xacro:property name="pendulum_radius" value="0.004"/>
  <xacro:property name="pendulum_mass" value="0.20"/>
  <xacro:property name="pendulum_y_offset" value="-0.20"/>
  <xacro:property name="pendulum_y_offset_abs" value="0.20"/>
  <xacro:property name="pendulum_coupler_radius" value="0.006"/>

  <material name="black">
    <color rgba="0.02 0.025 0.03 1"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.42 0.04 1"/>
  </material>
  <material name="steel">
    <color rgba="0.72 0.72 0.70 1"/>
  </material>
  <material name="blue">
    <color rgba="0.08 0.32 0.95 1"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.05 0.05 1"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.12 0.13 0.13 1"/>
  </material>
  <material name="rubber">
    <color rgba="0.01 0.01 0.01 1"/>
  </material>
  <material name="chain_steel">
    <color rgba="0.38 0.39 0.38 1"/>
  </material>
  <material name="aluminum">
    <color rgba="0.82 0.84 0.82 1"/>
  </material>
  <material name="brass">
    <color rgba="0.95 0.66 0.12 1"/>
  </material>
  <material name="yellow">
    <color rgba="0.95 0.74 0.08 1"/>
  </material>
  <material name="white">
    <color rgba="0.86 0.86 0.82 1"/>
  </material>
  <material name="screw_dark">
    <color rgba="0.03 0.03 0.035 1"/>
  </material>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia
      ixx="${mass / 12.0 * (y*y + z*z)}" ixy="0" ixz="0"
      iyy="${mass / 12.0 * (x*x + z*z)}" iyz="0"
      izz="${mass / 12.0 * (x*x + y*y)}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_z_inertia" params="mass radius length">
    <inertia
      ixx="${mass / 12.0 * (3.0*radius*radius + length*length)}" ixy="0" ixz="0"
      iyy="${mass / 12.0 * (3.0*radius*radius + length*length)}" iyz="0"
      izz="${0.5 * mass * radius * radius}"/>
  </xacro:macro>

  <xacro:macro name="screw_head" params="name x y z">
    <visual name="${name}">
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.004"/>
      </geometry>
      <material name="screw_dark"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="chain_link" params="name x y z">
    <visual name="${name}">
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.030 0.006"/>
      </geometry>
      <material name="chain_steel"/>
    </visual>
  </xacro:macro>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <mass value="10.6"/>
      <xacro:box_inertia mass="10.6" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </inertial>

    <visual name="base_plate">
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision name="base_plate_collision">
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <visual name="front_aluminum_extrusion">
      <origin xyz="0 ${base_width / 2.0 - 0.018} ${base_height + 0.012}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} 0.026 0.024"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <visual name="rear_aluminum_extrusion">
      <origin xyz="0 ${-base_width / 2.0 + 0.018} ${base_height + 0.012}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} 0.026 0.024"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <visual name="front_silver_edge">
      <origin xyz="0 ${base_width / 2.0 - 0.006} ${base_height + 0.030}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} 0.006 0.010"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <visual name="rear_silver_edge">
      <origin xyz="0 ${-base_width / 2.0 + 0.006} ${base_height + 0.030}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} 0.006 0.010"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <visual name="front_linear_rail_profile">
      <origin xyz="0 ${rail_y} ${rail_z - 0.025}" rpy="0 0 0"/>
      <geometry>
        <box size="${rail_length} 0.028 0.020"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <visual name="rear_linear_rail_profile">
      <origin xyz="0 ${-rail_y} ${rail_z - 0.025}" rpy="0 0 0"/>
      <geometry>
        <box size="${rail_length} 0.028 0.020"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <visual name="front_linear_shaft">
      <origin xyz="0 ${rail_y} ${rail_z}" rpy="0 ${PI / 2.0} 0"/>
      <geometry>
        <cylinder radius="${rail_radius}" length="${rail_length}"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual name="rear_linear_shaft">
      <origin xyz="0 ${-rail_y} ${rail_z}" rpy="0 ${PI / 2.0} 0"/>
      <geometry>
        <cylinder radius="${rail_radius}" length="${rail_length}"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual name="timing_belt">
      <origin xyz="0 0 ${rail_z - 0.025}" rpy="0 0 0"/>
      <geometry>
        <box size="${rail_length} 0.018 0.012"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <visual name="chain_back_track">
      <origin xyz="0 -0.130 ${rail_z + 0.028}" rpy="0 0 0"/>
      <geometry>
        <box size="${rail_length} 0.038 0.009"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <xacro:chain_link name="chain_link_00" x="-0.420" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_01" x="-0.374" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_02" x="-0.328" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_03" x="-0.282" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_04" x="-0.236" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_05" x="-0.190" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_06" x="-0.144" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_07" x="-0.098" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_08" x="-0.052" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_09" x="-0.006" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_10" x="0.040" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_11" x="0.086" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_12" x="0.132" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_13" x="0.178" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_14" x="0.224" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_15" x="0.270" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_16" x="0.316" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_17" x="0.362" y="-0.130" z="${rail_z + 0.036}"/>
    <xacro:chain_link name="chain_link_18" x="0.408" y="-0.130" z="${rail_z + 0.036}"/>
    <visual name="left_end_housing">
      <origin xyz="${-rail_length / 2.0} 0 ${rail_z - 0.015}" rpy="0 0 0"/>
      <geometry>
        <box size="0.085 0.285 0.075"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="right_end_housing">
      <origin xyz="${rail_length / 2.0} 0 ${rail_z - 0.015}" rpy="0 0 0"/>
      <geometry>
        <box size="0.085 0.285 0.075"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="left_chain_pulley">
      <origin xyz="${-rail_length / 2.0 + 0.015} -0.130 ${rail_z + 0.035}" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="0.026" length="0.044"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual name="right_chain_pulley">
      <origin xyz="${rail_length / 2.0 - 0.015} -0.130 ${rail_z + 0.035}" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="0.026" length="0.044"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual name="drive_motor_body">
      <origin xyz="${-rail_length / 2.0 - 0.030} ${base_width / 2.0 - 0.060} ${base_height + 0.040}" rpy="0 ${PI / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.115"/>
      </geometry>
      <material name="white"/>
    </visual>
    <visual name="drive_motor_front_band">
      <origin xyz="${-rail_length / 2.0 - 0.090} ${base_width / 2.0 - 0.060} ${base_height + 0.040}" rpy="0 ${PI / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.010"/>
      </geometry>
      <material name="screw_dark"/>
    </visual>
    <visual name="drive_motor_rear_band">
      <origin xyz="${-rail_length / 2.0 + 0.030} ${base_width / 2.0 - 0.060} ${base_height + 0.040}" rpy="0 ${PI / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.010"/>
      </geometry>
      <material name="screw_dark"/>
    </visual>
    <visual name="left_limit_switch">
      <origin xyz="${-travel / 2.0 - 0.025} 0 ${rail_z}" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.20 0.045"/>
      </geometry>
      <material name="red"/>
    </visual>
    <visual name="right_limit_switch">
      <origin xyz="${travel / 2.0 + 0.025} 0 ${rail_z}" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.20 0.045"/>
      </geometry>
      <material name="red"/>
    </visual>
    <xacro:screw_head name="screw_front_00" x="-0.450" y="${base_width / 2.0 - 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_front_01" x="-0.300" y="${base_width / 2.0 - 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_front_02" x="-0.150" y="${base_width / 2.0 - 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_front_03" x="0.000" y="${base_width / 2.0 - 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_front_04" x="0.150" y="${base_width / 2.0 - 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_front_05" x="0.300" y="${base_width / 2.0 - 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_front_06" x="0.450" y="${base_width / 2.0 - 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_rear_00" x="-0.450" y="${-base_width / 2.0 + 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_rear_01" x="-0.300" y="${-base_width / 2.0 + 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_rear_02" x="-0.150" y="${-base_width / 2.0 + 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_rear_03" x="0.000" y="${-base_width / 2.0 + 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_rear_04" x="0.150" y="${-base_width / 2.0 + 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_rear_05" x="0.300" y="${-base_width / 2.0 + 0.045}" z="${base_height + 0.003}"/>
    <xacro:screw_head name="screw_rear_06" x="0.450" y="${-base_width / 2.0 + 0.045}" z="${base_height + 0.003}"/>
  </link>

  <joint name="cart_slider" type="prismatic">
    <parent link="base_link"/>
    <child link="cart_link"/>
    <origin xyz="0 0 ${pivot_z}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-travel / 2.0}" upper="${travel / 2.0}" effort="150.0" velocity="2.2"/>
    <dynamics damping="0.02" friction="0.0005"/>
  </joint>

  <link name="cart_link">
    <inertial>
      <origin xyz="0 0 -0.24" rpy="0 0 0"/>
      <mass value="${cart_mass}"/>
      <xacro:box_inertia mass="${cart_mass}" x="${cart_x}" y="${cart_y}" z="0.42"/>
    </inertial>

    <visual name="linear_bearing_carriage">
      <origin xyz="0 0 -0.38" rpy="0 0 0"/>
      <geometry>
        <box size="${cart_x} ${cart_y} ${cart_z}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="linear_bearing_carriage_collision">
      <origin xyz="0 0 -0.38" rpy="0 0 0"/>
      <geometry>
        <box size="${cart_x} ${cart_y} ${cart_z}"/>
      </geometry>
    </collision>

    <visual name="carriage_top_plate">
      <origin xyz="0 0 -0.330" rpy="0 0 0"/>
      <geometry>
        <box size="0.155 0.125 0.018"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="front_bearing_sleeve">
      <origin xyz="0 ${rail_y} -0.400" rpy="0 ${PI / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.120"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <visual name="rear_bearing_sleeve">
      <origin xyz="0 ${-rail_y} -0.400" rpy="0 ${PI / 2.0} 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.120"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <visual name="carriage_belt_clamp">
      <origin xyz="0 -0.130 -0.365" rpy="0 0 0"/>
      <geometry>
        <box size="0.070 0.046 0.025"/>
      </geometry>
      <material name="chain_steel"/>
    </visual>
    <visual name="pendulum_encoder_bracket">
      <origin xyz="0 0 -0.19" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.38"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <collision name="pendulum_encoder_bracket_collision">
      <origin xyz="0 0 -0.19" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.05 0.38"/>
      </geometry>
    </collision>

    <visual name="encoder_hub">
      <origin xyz="0 0 0" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="0.026" length="0.075"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <visual name="encoder_outer_disk">
      <origin xyz="0 -0.034 0" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.010"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <visual name="encoder_inner_disk">
      <origin xyz="0 -0.042 0" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.012"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <visual name="pendulum_side_plate_left">
      <origin xyz="0.032 -0.025 -0.180" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.018 0.245"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="pendulum_side_plate_right">
      <origin xyz="-0.032 -0.025 -0.180" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.018 0.245"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="yellow_encoder_sensor">
      <origin xyz="-0.040 -0.042 -0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.014 0.030"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <joint name="pendulum_hinge" type="continuous">
    <parent link="cart_link"/>
    <child link="pendulum_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.0"/>
  </joint>

  <link name="pendulum_link">
    <inertial>
      <origin xyz="0 ${pendulum_y_offset} ${-pendulum_length / 2.0}" rpy="0 0 0"/>
      <mass value="${pendulum_mass}"/>
      <xacro:cylinder_z_inertia mass="${pendulum_mass}" radius="${pendulum_radius}" length="${pendulum_length}"/>
    </inertial>
    <visual name="shaft_coupler_visual">
      <origin xyz="0 ${pendulum_y_offset / 2.0} 0" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${pendulum_coupler_radius}" length="${pendulum_y_offset_abs}"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <collision name="shaft_coupler_collision">
      <origin xyz="0 ${pendulum_y_offset / 2.0} 0" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${pendulum_coupler_radius}" length="${pendulum_y_offset_abs}"/>
      </geometry>
    </collision>
    <visual name="rod_visual">
      <origin xyz="0 ${pendulum_y_offset} ${-pendulum_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${pendulum_radius}" length="${pendulum_length}"/>
      </geometry>
      <material name="steel"/>
    </visual>
    <collision name="rod_collision">
      <origin xyz="0 ${pendulum_y_offset} ${-pendulum_length / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${pendulum_radius}" length="${pendulum_length}"/>
      </geometry>
    </collision>
    <visual name="tip_marker">
      <origin xyz="0 ${pendulum_y_offset} ${-pendulum_length}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.011"/>
      </geometry>
      <material name="screw_dark"/>
    </visual>
  </link>

  <gazebo reference="base_link">
    <material>
      <ambient>0.02 0.025 0.03 1</ambient>
      <diffuse>0.02 0.025 0.03 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="cart_link">
    <material>
      <ambient>0.18 0.18 0.18 1</ambient>
      <diffuse>0.18 0.18 0.18 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="pendulum_link">
    <material>
      <ambient>0.72 0.72 0.70 1</ambient>
      <diffuse>0.72 0.72 0.70 1</diffuse>
    </material>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>cart_slider</joint_name>
      <joint_name>pendulum_hinge</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>cart_slider</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>pendulum_hinge</joint_name>
    </plugin>
  </gazebo>
</robot>
